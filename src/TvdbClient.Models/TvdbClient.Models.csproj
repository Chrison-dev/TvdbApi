<Project Sdk="Microsoft.NET.Sdk">

  <!-- API-VERSIONED project: the generated TheTVDB v4 DTOs. Its version tracks
       the TheTVDB API version (Major.Minor = API version; patch = our number).
       Regenerated by the Fallout `Generate` target — do not hand-edit TvdbModels.cs. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <PackageId>TvdbClient.Models</PackageId>
    <Title>TVDB Api Client — Models</Title>
    <Description>Generated data models (DTOs) for TheTVDB v4 API. Version tracks the TheTVDB API version.</Description>
    <!-- Generated code: suppress missing-XML-doc + non-nullable-uninitialized. -->
    <NoWarn>$(NoWarn);CS1591;CS8618</NoWarn>
  </PropertyGroup>

</Project>
